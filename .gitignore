
# ── Secrets ───────────────────────────────────────────────────────
# .env is untracked; commit .env.example instead as the documented template
.env
.env.*
!.env.example
.envrc
# secret-bearing local settings override, machine-specific
backend/config/settings/local.py
# kaggle CLI credentials (normally ~/.kaggle/kaggle.json)
kaggle.json
.kaggle/

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# virtualenvs
.venv/
venv/
env/
ENV/

# ── Django ────────────────────────────────────────────────────────
# *.sqlite3 already covers db.sqlite3
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
backend/media/
backend/staticfiles/
celerybeat-schedule*
celerybeat.pid
# application / Django logs
*.log
logs/

# ── Trained model artifacts ───────────────────────────────────────
# binaries are reproducible from data_prep/training/ — don't version them
# (keep the folders themselves so the structure stays visible)
backend/ml_models/*
!backend/ml_models/.gitkeep

# ── Node / frontend ───────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-error.log*
.next/
.nuxt/
.svelte-kit/
.vite/
dist/

# ── data_prep datasets & outputs ──────────────────────────────────
# 6 raw Kaggle datasets are re-downloadable via the kaggle CLI;
# processed CSVs are build output. Keep the folder skeletons only.
# NOTE: use /* not / — git cannot re-include a file if its parent
# directory is excluded, so the .gitkeep needs this form.
data_prep/raw/*
!data_prep/raw/.gitkeep
data_prep/processed/*
!data_prep/processed/.gitkeep

# ── Notebooks ─────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Tooling caches ────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ── OS / editor cruft ─────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~
*.bak
*.orig
*.rej
