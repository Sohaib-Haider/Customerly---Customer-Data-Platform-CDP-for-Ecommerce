# Backend configuration — copy to backend/.env and fill in locally.
# .env is gitignored; this example file intentionally contains no real values.

# manage.py, ASGI and WSGI default to config.settings.dev.
# Production: export DJANGO_SETTINGS_MODULE=config.settings.prod in the process.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins including scheme, needed only for trusted browser origins.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave blank for database-free local startup. ORM queries require credentials.
# Copy the exact Session pooler URL from Supabase > Connect; replace its password.
# URL-encode special characters in the password. Keep SSL enabled.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Accounts: "Continue with Google" needs an OAuth client id (Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID > Web application). Public value.
# Leave empty to offer only email + password.
GOOGLE_CLIENT_ID=

# Forgot-password emails. Leave EMAIL_HOST empty to print emails in the Django
# terminal. Gmail: any existing Gmail with 2-Step Verification and an "app
# password" (myaccount.google.com/apppasswords), not the normal password.
FRONTEND_URL=http://127.0.0.1:5173
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Customerly <no-reply@customerly.local>

# Existing column-mapping settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Private ingestion originals: use a persistent non-public directory in deployment.
# Default is backend/private_uploads/ (gitignored). Never expose it as public media.
# INGESTION_PRIVATE_ROOT=D:/private/customerly-uploads
