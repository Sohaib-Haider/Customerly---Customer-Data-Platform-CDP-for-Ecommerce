# Backend configuration — copy to backend/.env and fill in locally.
# .env is gitignored; this example file intentionally contains no real values.

# manage.py, ASGI and WSGI default to config.settings.dev.
# Production: export DJANGO_SETTINGS_MODULE=config.settings.prod in the process.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated origins including scheme, needed only for trusted browser origins.
DJANGO_CSRF_TRUSTED_ORIGINS=

# Leave blank for database-free local startup. ORM queries require credentials.
# Copy the exact Session pooler URL from Supabase > Connect; replace its password.
# URL-encode special characters in the password. Keep SSL enabled.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DATABASE_URL=

# Existing column-mapping settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
